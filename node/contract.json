{
  "schema_version": 1,
  "component": "node",
  "integration_version": 6,
  "shared_defaults": {
    "config_key": "defaults",
    "source_fields": [
      "repository",
      "path",
      "ref"
    ],
    "inheritable_fields": [
      "toolchain",
      "maintenance",
      "minimumReleaseAgeDays",
      "schedule"
    ],
    "recommended_file": "defaults/node-maintenance.json",
    "maximum_sources": 8,
    "local_overrides_win": true
  },
  "minimum_release_age_days_default": 10,
  "configuration_issue": {
    "title": "Node audit configuration",
    "marker": "<!-- node-audit-configuration:v1 -->",
    "permission": "issues: write",
    "reuse_closed_issue": true
  },
  "maintenance_defaults": {
    "mode": "security-only",
    "upgradeScope": "major"
  },
  "toolchain_config": "toolchain",
  "toolchain_defaults": {
    "node": "project",
    "npm": "project",
    "pnpm": "project"
  },
  "caller_template": "node/caller.yml",
  "consumer_config": ".github/node-maintenance.json",
  "consumer_workflow": ".github/workflows/dependency-audit.yml",
  "audit_schedules": {
    "config_key": "schedule",
    "inheritable_since": 6,
    "merge": "local cron list replaces inherited list per kind",
    "kinds": [
      "security",
      "upgrades"
    ],
    "new_installation": {
      "security": [
        "0 2 * * 1"
      ],
      "upgrades": []
    },
    "manual_input": "audit-kind",
    "manual_choices": [
      "security",
      "upgrades"
    ],
    "pull_request_branch": "maintenance/dependency-audit",
    "cron_lists_supported": true
  },
  "package_managers": [
    "npm",
    "pnpm"
  ],
  "project_scope": "one standalone package directory and lockfile",
  "validation_script_default": "build",
  "breaking_changes": {
    "previous_component": "docusaurus",
    "old_configuration": ".github/docusaurus.json",
    "old_script_option": "buildScript",
    "compatibility_layer": false
  },
  "cron_list_maintenance_mode_default": "security-and-maintenance"
}
