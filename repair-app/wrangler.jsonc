{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-approved-worker-name",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "env": {
    "preview": {
      "name": "replace-with-approved-preview-worker-name",
      "workers_dev": true,
      "triggers": {"crons": ["17 3 * * *"]},
      "d1_databases": [{
        "binding": "DB",
        "database_name": "replace-with-approved-database-name",
        "database_id": "00000000-0000-0000-0000-000000000000"
      }]
    }
  }
}
